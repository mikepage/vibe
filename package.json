{
  "name": "vibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A vibe-coding platform on Cloudflare Workers: Claude writes apps, worker-bundler builds them, Worker Loader runs them. Pages on Nuxt UI, sign-in through Cloudflare Access.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "void db migrate && vite dev",
    "build": "vite build",
    "lint": "tools/lint/node_modules/.bin/eslint --config tools/lint/eslint.config.js --max-warnings 0 .",
    "check": "vite build --logLevel warn && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "measure": "node scripts/measure.ts",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "tag": "changeset git-tag"
  },
  "dependencies": {
    "@cloudflare/worker-bundler": "0.2.6",
    "@iconify-json/lucide": "1.2.154",
    "@nuxt/ui": "4.12.0",
    "@void/vue": "1.8.0",
    "better-auth": "1.7.22",
    "hono": "4.13.18",
    "tailwindcss": "4.3.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "void": "1.8.0",
    "wrangler": "4.161.0"
  }
}
